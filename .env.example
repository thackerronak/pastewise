# Laya runs in the browser. Its model files are downloaded from here (a Hugging Face repo, or any CORS-enabled host
# with the same layout: manifest.json, tokenizer files, and the ONNX builds).
NEXT_PUBLIC_LAYA_MODEL_BASE=https://huggingface.co/VishalMysore/layaForWebTrained/resolve/main/

# Tev1, the default on-device model: a Hugging Face repo with model.onnx, model.onnx.data, genai_config.json and the
# tokenizer files. Sizes and checksums come from the Hub API at NEXT_PUBLIC_HF_HUB.
NEXT_PUBLIC_TEV1_REPO=goldenfox/tev1-0.8b-decision-onnx
NEXT_PUBLIC_HF_HUB=https://huggingface.co

# Jev uses the visitor's own TypeSafe key, entered in the page and kept only for that tab. No server key is needed.
# Pin a model version so classifications don't shift under you.
JEV_MODEL=jev-latest
